# TrustMy.IP (TrustIP) — environment reference
#
# EVERY VARIABLE IN THIS FILE IS OPTIONAL. A deployment with no .env at all —
# or with this whole file blank — is a supported configuration: the backend
# boots, the frontend builds, and every feature whose upstream needs a
# credential is hidden or answers "API key is missing" instead of failing.
# Nothing here is required to run the site.
#
# What you get with zero configuration:
#   working  — IP cards + Query IP (ipinfo.io / ip-api.com / ip.sb, keyless),
#              MaxMind (needs the two .mmdb files on disk — see MAXMIND_*),
#              Whois / RDAP, DNS Resolver, MAC Lookup, IP Calculator, WebRTC,
#              standard DNS-leak test, Speed / Globalping MTR / Latency /
#              Censorship checks, Connectivity check, Service Status, ASN info
#              + history + upstream topology (RIPEstat + CAIDA, keyless),
#              browser fingerprint, security checklist, IP history, achievements,
#              keyboard shortcuts, PWA, dark mode, all shipped languages.
#   hidden   — anything gated on a credential below: Google Static Maps button,
#              Cloudflare Radar views + ASN "live" links, IPCheck.ing API source,
#              shareable report links, per-user features (Firebase), Sentry,
#              Earth Online, in-app docs assistant, curl API.
#
# Copy to .env and fill in only what you want; dotenv reads it at boot, and
# VITE_* values are baked into the frontend bundle at build time (changing one
# needs a rebuild, not just a restart).
#
# Server
# BACKEND_PORT — Express API port (default 11966). frontend-server.js and the
#   Vite dev proxy both read it, so set it once and both halves follow.
# FRONTEND_PORT — static server port, the one visitors reach (default 18966).
# ALLOWED_DOMAINS — comma-separated hostnames allowed to call /api/*. The
#   global requireReferer guard rejects any other Origin/Referer with 403.
#   localhost and 127.0.0.1 are always allowed, so an empty value only breaks
#   non-localhost deployments: on a real domain, set this or every API call
#   from a visitor gets 403.
BACKEND_PORT="11966"
FRONTEND_PORT="18966"
ALLOWED_DOMAINS=""

# SITE
# VITE_SITE_URL — the single source of this deployment's canonical origin.
#   It feeds the canonical / og:url / twitter:image / JSON-LD block in
#   index.html (substituted by siteUrlHtmlPlugin in vite.config.js) and the
#   third segment of the outbound User-Agent (common/upstream-ua.js).
#   Unset: that whole conditional <head> block is dropped from the build (no
#   `undefined` is ever emitted) and the UA degrades to `TrustIP/v<version>`.
#   Nothing stops working — you only lose canonical-tag/og absolute URLs, so
#   set it to your public origin as soon as you have one.
VITE_SITE_URL=""

# THIRD-PARTY APIs — each key enables one data source; empty keeps it off.
# GOOGLE_MAP_API_KEY — the Static Maps image behind the IP card's map button.
#   Empty: the button is hidden (configs.map=false); nothing else changes.
GOOGLE_MAP_API_KEY=""
# IPINFO_API_KEY — raises ipinfo.io from its keyless free quota to an
#   authenticated one, and lights the source card. Empty still works: the
#   handler calls ipinfo.io without a token.
#   (IPINFO_API_TOKEN is the pre-rename spelling, still read as a fallback.)
IPINFO_API_KEY=""
# IPAPIIS_API_KEY — api.ipapi.is geolocation + isHosting / isProxy flags.
#   Comma-separated keys are rotated at random. Empty: /api/ipapiis answers
#   "API key is missing" and the source card stays hidden.
IPAPIIS_API_KEY=""
# IP2LOCATION_API_KEY — api.ip2location.io geolocation. The upstream requires
#   a key, so empty behaves exactly as above.
#   (The upstream's free tier also needs the key — there is no keyless mode.)
IP2LOCATION_API_KEY=""
# MAC_LOOKUP_API_KEY — higher rate limits on api.maclookup.app. Empty keeps
#   the MAC lookup working against the keyless endpoint.
MAC_LOOKUP_API_KEY=""
# RIPESTAT_SOURCE_APP — the `sourceapp` identifier sent to RIPEstat with every
#   as-overview / routing-history call; empty sends `trustip`. Set it only to
#   register your own deployment name with RIPE NCC.
RIPESTAT_SOURCE_APP=""
# CLOUDFLARE_API_KEY — Cloudflare Radar (traffic / BGP / quality / outage
#   feeds behind /api/cfradar) and the ASN "live in Radar" links.
#   Empty: those views answer "API key is missing" and the Radar panels are
#   hidden. Also needs the "Workers KV Storage: Edit" permission when used for
#   shareable reports below. (CLOUDFLARE_API is the pre-rename fallback.)
CLOUDFLARE_API_KEY=""

# Shareable diagnostic reports — stored in Cloudflare Workers KV. All three
# CLOUDFLARE_* values must be set (CLOUDFLARE_API_KEY additionally needs the
# "Workers KV Storage: Edit" permission) or POST/GET /api/report answer 503 and
# /api/configs reports reportSharing=false, so the "Share" dialog stays
# hidden. CLOUDFLARE_KV_NAMESPACE_ID is the namespace's hex ID from the
# dashboard, not its name.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_KV_NAMESPACE_ID=""

# IPCHECKING_API_KEY + IPCHECKING_API_ENDPOINT — the upstream project's
#   private IPCheck.ing API: the IPCheck.ing IP card, the enhanced DNS-leak
#   test, the invisibility test, Persona Check, achievements/user info.
#   BOTH are needed — a key without an endpoint is treated as unconfigured.
#   This fork has no credentials for it, so leave both empty: /api/configs
#   reports ipChecking=false, the gated tools stay hidden, and the browser
#   detects the visitor's own IP through the public trace endpoints instead.
IPCHECKING_API_KEY=""
IPCHECKING_API_ENDPOINT=""

# MaxMind — GeoLite2 City + ASN databases, read locally by /api/maxmind.
# The .mmdb files live in common/maxmind-db/. There are two ways to have them:
#   1. set MAXMIND_ACCOUNT_ID + MAXMIND_LICENSE_KEY (free license key from
#      maxmind.com) and MAXMIND_AUTO_UPDATE="true" — the backend downloads
#      them at boot when missing and re-checks daily; or
#   2. drop GeoLite2-City.mmdb + GeoLite2-ASN.mmdb into that folder yourself.
# With neither, the backend still boots and /api/maxmind answers
# 503 "MaxMind database is not ready" — a warning at startup, not a crash.
# Other IP sources keep working, so this is not required to run the site.
MAXMIND_ACCOUNT_ID=""
MAXMIND_LICENSE_KEY=""
# MAXMIND_AUTO_UPDATE — "true" enables the daily re-check (and the boot
#   download when credentials are present). Anything else leaves the files
#   alone. Credentials still trigger the one-time boot download either way.
MAXMIND_AUTO_UPDATE="false"

# CAIDA — AS-to-organization and AS-relationship snapshots, downloaded into
# common/as-org-db/ and common/as-rel-db/ (both are gitignored: non-commercial
# license). No credentials exist for this dataset: bootstrapCaidaIfMissing()
# always runs at boot and pulls both files with zero configuration, so ASN org
# names and the upstream-topology graph work out of the box. Only the *periodic
# re-check* is opt-in here.
# CAIDA_AUTO_UPDATE="true" re-checks daily (a fresh as-rel2 takes ~1 min and
# a few hundred MB of scratch space). With it off, the snapshot you booted with
# ages but never surprises a request path.
CAIDA_AUTO_UPDATE="false"

# User system (Firebase Auth) — all three are required to enable sign-in, and
# sign-in is only useful if IPCHECKING_API_KEY above is set too: the user's
# profile, achievements and enhanced DNS-leak sessions live behind that API.
# With any of them empty, firebase/app and firebase/auth never enter the
# bundle (lazy, env-gated import), the nav shows the standalone preferences
# cog instead of a user menu, and the browser logs no Firebase errors.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""

# VITE_INVISIBILITY_TEST_KEY — the proxy-detection script key for the
# Invisibility Test, issued by the IPCheck.ing service that runs the check.
# Like IPCHECKING_API_KEY this belongs to the upstream service: without it the
# tool is hidden outright (it is gated on the canonical deployment), so a
# self-hosted fork never loads the third-party script.
VITE_INVISIBILITY_TEST_KEY=""

# DOCS SITE — origin of the GitBook docs site powering the in-app
# assistant and the Help Center link. Empty disables both.
VITE_DOCS_URL=""

# EARTH ONLINE — full URL of the pulse backend (trailing slashes stripped).
# Empty hides the social parts (status feed / visitor map / visit beacon) at
# build time, like Sentry. The outage feed is independent — it only needs
# CLOUDFLARE_API_KEY above.
VITE_PULSE_BEACON_URL=""

# CURL API — the hostnames printed in the "get your IP from the terminal"
# card. They must be domains you serve yourself; all three must be set or the
# card is hidden (store.curlDomainsHadSet). Empty: nothing breaks, the card
# simply does not render.
VITE_CURL_IPV4_DOMAIN=""
VITE_CURL_IPV6_DOMAIN=""
VITE_CURL_IPV64_DOMAIN=""

# Google Analytics — a GA4 measurement id (G-XXXX…). Empty means gtag.js is
# never requested and the privacy page states no analytics notice. Setting it
# starts sending page views to Google, so it is off by default on purpose.
VITE_GOOGLE_ANALYTICS_ID=""

# Security related
# SECURITY_BLACKLIST_LOG_FILE_PATH: opt-in on-disk ledger of rate-limited IPs
# (e.g. "logs/blacklist-ip.log"). Empty = no file; the event is always logged
# via the shared logger either way (and mirrored to Sentry when configured).
SECURITY_BLACKLIST_LOG_FILE_PATH=""
# SECURITY_RATE_LIMIT — requests per 20 minutes per IP before a 429. 0 / empty
# = no limiter (the default). Only worth setting on an internet-facing box.
# SECURITY_DELAY_AFTER — after this many requests in an hour each response is
# delayed by (count − limit) × 400 ms, capped at 5 s. 0 / empty = off.
SECURITY_RATE_LIMIT=""
SECURITY_DELAY_AFTER=""

# Sentry — all optional; leave empty and no Sentry code ships or runs at all.
# VITE_SENTRY_DSN_FRONTEND: frontend DSN (build-time; baked into the bundle;
#   also read by the backend at runtime as the allowlist for /api/monitoring,
#   the first-party tunnel that relays envelopes past ad blockers). Without it
#   the tunnel route is not even mounted.
# SENTRY_DSN_BACKEND: backend DSN (runtime; read by sentry-instrument.js)
# SENTRY_ENVIRONMENT: backend environment tag — unset means "production",
#   set "development" on dev machines (frontend tags itself automatically)
# SENTRY_ORG / SENTRY_PROJECT_FRONTEND / SENTRY_AUTH_TOKEN: source-map upload
# at build time only — the token is a secret, never exposed to the browser
VITE_SENTRY_DSN_FRONTEND=""
SENTRY_DSN_BACKEND=""
SENTRY_ENVIRONMENT=""
SENTRY_ORG=""
SENTRY_PROJECT_FRONTEND=""
SENTRY_AUTH_TOKEN=""

# Logging — LOG_LEVEL: debug/info/warn/error (default info)
#           LOG_FORMAT: "json" for log shippers, anything else = pretty
#           LOG_HTTP: "true" to enable per-request /api logging (off by default)
LOG_LEVEL=""
LOG_FORMAT=""
LOG_HTTP=""
