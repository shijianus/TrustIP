.git
.github
.VSCodeCounter
.claude
.vscode

node_modules
dist
logs
localtest
package-lock.json

.DS_Store
# Every env file, .env.example included: the image ships no configuration —
# mount or pass one at run time.
.env*
*.log
scripts/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime-downloaded datasets — never bake them into the image. A clean CI build
# wouldn't have them anyway; this keeps a local build (which has them on disk from
# `pnpm dev`) consistent with CI, so the container always downloads fresh data on
# first boot. Same pattern as .gitignore.
common/*-db/

# Never needed by `pnpm run build` or the runtime, and must not leak into an
# image layer: the test suite, deployment evidence, docs and deploy samples.
tests/
evidence*/
**/evidence*/
docs/
deploy/
coverage/
